
install.packages("ranger")
library(ranger)
library(tidyverse)
library(data.table)

genomicData <- fread("RandomforestSubset.raw", header = T)

genomicData<-subset(genomicData, select=-c(PAT:SEX))
genomicData<-subset(genomicData, select=-c(FID:IID))

#subset training data
train.idx <- sample(nrow(genomicData), 2/3 * nrow(genomicData))
iris.train <- genomicData[train.idx, ] 
iris.test <- genomicData[-train.idx, ]

# Add prefix using paste() and colnames()
colnames(genomicData) <- paste("a", colnames(genomicData), sep = "")
#colnames(iris.test) <- paste("a", colnames(iris.test), sep = "")

#print(iris.train)
#run random forest with training data
set.seed(__)
rg.iris1 <- ranger(aPHENOTYPE ~ ., data = genomicData, mtry =__, num.trees =1500, importance = "impurity")

rg.iris <- ranger(aPHENOTYPE ~ ., data = iris.train, mtry =__, num.trees =1500, importance = "impurity")

#use random forest model to predict the outcome of the test data
pred.iris <- predict(rg.iris, data = iris.test)
plot(x=iris.test$aPHENOTYPE, y=pred.iris$predictions)
model1<-lm(iris.test$aPHENOTYPE~pred.iris$predictions)
summary(model1)

SNP_importance<-as.data.frame(rg.iris$variable.importance)
write.table(SNP_importance, file = "seed___SNPimportance.txt", sep = ",", row.names = TRUE, col.names = TRUE)

