library(tidyverse)
library(data.table)
library(vegan)

genomicDataCMP <- fread("testmafCMP.raw", header = T)

rawsubsetCMP<-subset(genomicDataCMP, select=-c(FID:PHENOTYPE))
rawsubsetIDCMP<-subset(genomicDataCMP, select=c(FID:PHENOTYPE))

rdaGenomeCMP <- rda(rawsubsetCMP~rawsubsetIDCMP$PHENOTYPE, scale=T)

RsquareAdj(rdaGenomeCMP)

#are PCA values associated with CTmax - correlation do that ((already done, with GEMMA - use that))
chrom_mapFull <- fread("testmafCMP.bim") %>%
  mutate(CHROM = V1, SNP = V2, BP = V4) %>% 
  select(CHROM, SNP, BP)

#Function to map RDA scores
#Knum is number of RDA axes to use 
RDA_scores_map<- function(RDAobj, mapobj, Knum) {
  RDAscores <- data.frame(abs(RDAobj$CCA$v[,1:Knum])) #get absolute values of RDA scores for easy plotting
  colnames(RDAscores) <- paste0("absRDA", rep(1:Knum))
  RDAobj_map <- bind_cols(mapobj, RDAscores)
  return(RDAobj_map)}

#Call the function on our rda object and chrom map
rdaLoadingsMap <- RDA_scores_map(rdaGenomeCMP, chrom_mapFull, 1)

library(qqman)
cutoff<-quantile(rdaLoadingsMap$absRDA1, 0.99, na.rm=T)
# Make the Manhattan plot on the gwasResults dataset
manhattan(rdaLoadingsMap, snp = "SNP", bp = "BP", chr = "CHROM", p= "absRDA1", logp = FALSE, ylab="", suggestiveline = cutoff, ylim=c(0,0.003))
         
topRDA_CMP<-subset(rdaLoadingsMap, absRDA1>cutoff)
write.table(topRDA_CMP, "TopCMP_withmaf_RDA.txt", sep="\t")
